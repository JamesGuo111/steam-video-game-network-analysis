    given-names: Zijing
repository-code: "https://github.com/JamesGuo111/steam-video-game-network-analysis"
date-released: 2026-05-15
keywords:
  - network analysis
  - bipartite network
  - community detection
  - backbone extraction
  - video games
  - Steam
  - R
  - Shiny
